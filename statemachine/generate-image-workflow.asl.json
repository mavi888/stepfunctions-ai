{
    "Comment": "A description of my state machine",
    "StartAt": "Get Prompt for image generation",
    "States": {
        "Get Prompt for image generation": {
            "Type": "Task",
            "Arguments": {
                "Bucket": "${DataBucketName}",
                "Key": "prompts/bedrock-image-prompt.txt"
            },
            "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
            "Next": "Generate prompt for image generation",
            "Assign": {
                "id": "{% $states.input.id %}",
                "articleSummary": "{% $states.input.summary %}",
                "createImageGenerationPrompt": "{% $states.result.Body %}"
            }
        },
        "Generate prompt for image generation": {
            "Type": "Task",
            "Arguments": {
                "ModelId": "amazon.titan-text-express-v1",
                "ContentType": "application/json",
                "Body": {
                    "inputText": "{% $createImageGenerationPrompt & $articleSummary %}",
                    "textGenerationConfig": {
                        "maxTokenCount": 512,
                        "temperature": 0.7,
                        "topP": 0.9,
                        "stopSequences": []
                    }
                }
            },
            "Resource": "arn:aws:states:::bedrock:invokeModel",
            "Next": "Generate Image",
            "Assign": {
                "imageGenerationPrompt": "{% $states.result.Body.results[0].outputText %}",
                "retryCount": "{% $exists($retryCount) ? $retryCount : 0 %}"
            }
        },
        "Generate Image": {
            "Type": "Task",
            "Arguments": {
                "ModelId": "amazon.titan-image-generator-v1",
                "ContentType": "application/json",
                "Accept": "application/json",
                "Body": {
                    "taskType": "TEXT_IMAGE",
                    "textToImageParams": {
                        "text": "{% $imageGenerationPrompt %}"
                    },
                    "imageGenerationConfig": {
                        "numberOfImages": 1,
                        "quality": "standard",
                        "cfgScale": 8,
                        "height": 512,
                        "width": 512
                    }
                },
                "Output": {
                    "S3Uri": "s3://${DataBucketName}/generated-image.json"
                }
            },
            "Resource": "arn:aws:states:::bedrock:invokeModel",
            "Next": "Process image",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Comment": "When the image generation fails",
                    "Next": "Check retry limit"
                }
            ]
        },
        "Check retry limit": {
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "Increment retry counter",
                    "Condition": "{% $retryCount < 2 %}",
                    "Comment": "Retry if the limit was not reached"
                }
            ],
            "Default": "Image generation failed"
        },
        "Increment retry counter": {
            "Type": "Pass",
            "Next": "Generate prompt for image generation",
            "Assign": {
                "retryCount": "{% $retryCount + 1 %}"
            }
        },
        "Image generation failed": {
            "Type": "Pass",
            "End": true
        },
        "Process image": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Output": "{% $states.result.Payload %}",
            "Arguments": {
                "FunctionName": "${ProcessImageFunctionArn}",
                "Payload": {
                    "bucketName": "${DataBucketName}",
                    "sourceKey": "generated-image.json",
                    "targetKey": "{% $id & '-generated-image.png' %}"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "End": true
        }
    },
    "QueryLanguage": "JSONata"
}