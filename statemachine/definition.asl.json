{
    "Comment": "A description of my state machine",
    "StartAt": "Get article summary",
    "States": {
        "Get article summary": {
            "Type": "Task",
            "Arguments": {
                "Bucket": "${DataBucketName}",
                "Key": "{% $states.input.dynamodb.Keys.id.S & '-perplexity-summary.txt' %}"
            },
            "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
            "Next": "S3 Sign URL",
            "Assign": {
                "id": "{% $states.input.dynamodb.Keys.id.S %}",
                "url": "{% $states.input.dynamodb.NewImage.url.S %}",
                "isNews": "{% $states.input.dynamodb.NewImage.isNews.BOOL %}",
                "articleSummary": "{% $exists($states.result.Body) ? $states.result.Body : '' %}"
            },
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "Get prompt for Perplexity"
                }
            ]
        },
        "Get prompt for Perplexity": {
            "Type": "Task",
            "Arguments": {
                "Bucket": "${DataBucketName}",
                "Key": "prompts/perplexity-summary.txt"
            },
            "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
            "Next": "Call perplexity for summarizing article",
            "Assign": {
                "perplexityPrompt": "{% $states.result.Body %}"
            }
        },
        "Call perplexity for summarizing article": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Arguments": {
                "ApiEndpoint": "https://api.perplexity.ai/chat/completions",
                "Method": "POST",
                "InvocationConfig": {
                    "ConnectionArn": "${PerplexityConnectionArn}"
                },
                "RequestBody": {
                    "model": "sonar",
                    "messages": [
                        {
                            "role": "user",
                            "content": "{% $perplexityPrompt & $url %}"
                        }
                    ]
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "BackoffRate": 2,
                    "IntervalSeconds": 5,
                    "MaxAttempts": 3,
                    "JitterStrategy": "FULL",
                    "Comment": "If any error"
                }
            ],
            "Next": "Save perplexity summary in S3",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Comment": "If there is any error that is not solvable",
                    "Next": "Success"
                }
            ],
            "Assign": {
                "articleSummary": "{% $exists($states.result.ResponseBody.choices.message.content) ? $states.result.ResponseBody.choices.message.content : '' %}"
            }
        },
        "Save perplexity summary in S3": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
            "Arguments": {
                "Body": "{% $articleSummary %}",
                "Bucket": "${DataBucketName}",
                "Key": "{% $id & '-perplexity-summary.txt' %}"
            },
            "Next": "S3 Sign URL"
        },
        "S3 Sign URL": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Output": "{% $states.result.Payload %}",
            "Arguments": {
                "FunctionName": "${SignS3UrlFunctionArn}",
                "Payload": {
                    "bucketName": "${DataBucketName}",
                    "objectKey": "{% $id & '-perplexity-summary.txt' %}"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "Next": "Send an email when new summary",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "Success",
                    "Output": {
                        "error": "Error en la función de lambda que firma los archivos de S3"
                    }
                }
            ]
        },
        "Send an email when new summary": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sns:publish",
            "Arguments": {
                "Message": {
                    "fileURL": "{% $states.input.signedUrl %}",
                    "summary": "{% $articleSummary %}"
                },
                "TopicArn": "${SNSTopicArn}"
            },
            "Next": "Is news?"
        },
        "Is news?": {
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "Parallel",
                    "Condition": "{% ($isNews) = (true) %}"
                }
            ],
            "Default": "Success"
        },
        "Parallel": {
            "Type": "Parallel",
            "Branches": [
                {
                    "StartAt": "Get prompt for LinkedIn Post",
                    "States": {
                        "Get prompt for LinkedIn Post": {
                            "Type": "Task",
                            "Arguments": {
                                "Bucket": "${DataBucketName}",
                                "Key": "prompts/bedrock-linkedin-prompt.txt"
                            },
                            "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
                            "Assign": {
                                "linkedInPrompt": "{% $states.result.Body %}"
                            },
                            "Next": "Get Linkedin Post with Bedrock"
                        },
                        "Get Linkedin Post with Bedrock": {
                            "Type": "Task",
                            "Arguments": {
                                "ModelId": "amazon.titan-text-express-v1",
                                "ContentType": "application/json",
                                "Body": {
                                    "inputText": "{% $linkedInPrompt & $articleSummary %}",
                                    "textGenerationConfig": {
                                        "maxTokenCount": 512,
                                        "temperature": 0.7,
                                        "topP": 0.9,
                                        "stopSequences": []
                                    }
                                }
                            },
                            "Resource": "arn:aws:states:::bedrock:invokeModel",
                            "Assign": {
                                "LinkedInPost": "{% $states.result.Body.results[0].outputText %}"
                            },
                            "Next": "Guardar linkedin post en DynamoDB"
                        },
                        "Guardar linkedin post en DynamoDB": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::dynamodb:updateItem",
                            "Arguments": {
                                "TableName": "${DynamoDbDataSourceTableName}",
                                "Key": {
                                    "id": {
                                        "S": "{% $id %}"
                                    }
                                },
                                "UpdateExpression": "SET linkedInPost = :linkedInPost",
                                "ExpressionAttributeValues": {
                                    ":linkedInPost": {
                                        "S": "{% $LinkedInPost %}"
                                    }
                                }
                            },
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "Get prompt for X Post",
                    "States": {
                        "Get prompt for X Post": {
                            "Type": "Task",
                            "Arguments": {
                                "Bucket": "${DataBucketName}",
                                "Key": "prompts/bedrock-x-prompt.txt"
                            },
                            "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
                            "Assign": {
                                "xPrompt": "{% $states.result.Body %}"
                            },
                            "Next": "Get X Post with Bedrock"
                        },
                        "Get X Post with Bedrock": {
                            "Type": "Task",
                            "Arguments": {
                                "ModelId": "amazon.titan-text-express-v1",
                                "ContentType": "application/json",
                                "Body": {
                                    "inputText": "{% $xPrompt & $articleSummary %}",
                                    "textGenerationConfig": {
                                        "maxTokenCount": 512,
                                        "temperature": 0.7,
                                        "topP": 0.9,
                                        "stopSequences": []
                                    }
                                }
                            },
                            "Resource": "arn:aws:states:::bedrock:invokeModel",
                            "Assign": {
                                "xPost": "{% $states.result.Body.results[0].outputText %}"
                            },
                            "Next": "Guardar X post en DynamoDB"
                        },
                        "Guardar X post en DynamoDB": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::dynamodb:updateItem",
                            "Arguments": {
                                "TableName": "${DynamoDbDataSourceTableName}",
                                "Key": {
                                    "id": {
                                        "S": "{% $id %}"
                                    }
                                },
                                "UpdateExpression": "SET xPost = :xPost",
                                "ExpressionAttributeValues": {
                                    ":linkedInPost": {
                                        "S": "{% $xPost %}"
                                    }
                                }
                            },
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "Generate image",
                    "States": {
                        "Generate image": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::states:startExecution",
                            "Arguments": {
                                "StateMachineArn": "${GenerateImageStateMachineArn}",
                                "Input": {
                                    "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID": "{% $states.context.Execution.Id %}",
                                    "id": "{% $id %}",
                                    "summary": "{% $articleSummary %}"
                                }
                            },
                            "End": true
                        }
                    }
                }
            ],
            "End": true
        },
        "Success": {
            "Type": "Succeed"
        }
    },
    "QueryLanguage": "JSONata"
}